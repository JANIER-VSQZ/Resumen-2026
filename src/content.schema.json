{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contenido de los proyectos de ASONOG",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "institution": {
      "type": "string",
      "description": "Nombre de la institución."
    },
    "period": {
      "type": "string",
      "description": "Año o período de la presentación."
    },
    "subtitle": {
      "type": "string",
      "description": "Subtítulo de la portada."
    },
    "sourceNote": {
      "type": "string",
      "description": "Nota sobre las fuentes de información."
    },
    "projects": {
      "type": "array",
      "description": "Una entrada por proyecto; dentro se cargan sus departamentos.",
      "items": {
        "$ref": "#/definitions/project"
      }
    },
    "mapThumbnails": {
      "type": "object",
      "additionalProperties": false,
      "description": "Miniaturas independientes para cada mapa. Si una entrada está vacía, se muestra el color del departamento.",
      "properties": {
        "cover": {
          "$ref": "#/definitions/mapThumbnailSet",
          "description": "Mapa de portada: conserva sus fotografías institucionales."
        },
        "interactive": {
          "$ref": "#/definitions/mapThumbnailSet",
          "description": "Mapa interactivo con filtros. Sus imágenes no se heredan de la portada."
        },
        "detail": {
          "$ref": "#/definitions/mapThumbnailSet",
          "description": "Mapas dentro de los detalles de proyectos. Solo se usan en su cobertura."
        }
      }
    }
  },
  "definitions": {
    "departmentName": {
      "type": "string",
      "enum": [
        "Atlántida",
        "Choluteca",
        "Colón",
        "Comayagua",
        "Copán",
        "Cortés",
        "El Paraíso",
        "Francisco Morazán",
        "Gracias a Dios",
        "Intibucá",
        "Islas de la Bahía",
        "La Paz",
        "Lempira",
        "Ocotepeque",
        "Olancho",
        "Santa Bárbara",
        "Valle",
        "Yoro"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^(/(?![/\\\\])|https?://|data:image/(jpeg|png|webp);base64,)"
    },
    "optionalImage": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/definitions/image"
        }
      ]
    },
    "textList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "default": []
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "departments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Identificador único y estable del proyecto, usado en su enlace."
        },
        "name": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nombre del proyecto. Se escribe una sola vez."
        },
        "verified": {
          "type": "boolean",
          "default": false,
          "description": "Activa la publicación del proyecto cuando su información esté revisada."
        },
        "demo": {
          "type": "boolean",
          "default": false,
          "description": "Marca contenido de demostración."
        },
        "beneficiaries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": null,
          "description": "Personas registradas en el proyecto; null si está pendiente."
        },
        "axis": {
          "type": "string",
          "description": "Actividad o eje común; cada bloque territorial puede indicar el suyo."
        },
        "summary": {
          "type": "string",
          "description": "Resumen común; cada bloque territorial puede indicar el suyo."
        },
        "departments": {
          "type": "array",
          "description": "Bloques de trabajo por departamento o grupo de departamentos.",
          "items": {
            "$ref": "#/definitions/territory"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "verified"
                ],
                "properties": {
                  "verified": {
                    "const": true
                  }
                }
              },
              {
                "required": [
                  "demo"
                ],
                "properties": {
                  "demo": {
                    "const": true
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "departments": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "territory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S",
          "description": "Identificador opcional del bloque. No es necesario rellenarlo."
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Departamentos donde se realizaron estas actividades. Añade varios si comparten la misma información.",
          "items": {
            "$ref": "#/definitions/departmentName"
          }
        },
        "axis": {
          "type": "string",
          "description": "Actividad principal o eje de este territorio."
        },
        "summary": {
          "type": "string",
          "description": "Resumen del trabajo en estos departamentos."
        },
        "communities": {
          "$ref": "#/definitions/textList",
          "description": "Comunidades de intervención."
        },
        "activities": {
          "$ref": "#/definitions/textList",
          "description": "Actividades realizadas. Puede estar vacío mientras completas la información."
        },
        "achievements": {
          "$ref": "#/definitions/textList",
          "description": "Logros documentados."
        },
        "photos": {
          "type": "array",
          "description": "Fotografías de este bloque territorial.",
          "items": {
            "$ref": "#/definitions/photo"
          },
          "default": []
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "$ref": "#/definitions/image",
          "description": "Ruta desde public, por ejemplo /FotosProyectos/taller.png."
        },
        "description": {
          "type": "string",
          "description": "Descripción visible bajo la fotografía."
        },
        "community": {
          "type": "string",
          "description": "Lugar o comunidad de la fotografía."
        },
        "date": {
          "type": "string",
          "description": "Fecha, normalmente YYYY-MM-DD. Puede quedar vacía."
        },
        "id": {
          "type": "string",
          "description": "Identificador opcional de la fotografía."
        },
        "featured": {
          "type": "boolean",
          "default": false,
          "description": "Muestra esta fotografía al principio."
        },
        "thumbnail": {
          "$ref": "#/definitions/optionalImage"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "thumbnailWidth": {
          "type": "integer",
          "minimum": 1
        },
        "focalX": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "focalY": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        }
      }
    },
    "mapThumbnailSet": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/departmentName"
      },
      "additionalProperties": {
        "$ref": "#/definitions/optionalImage"
      }
    }
  }
}

{
  "name": "asonog-exposicion-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test scripts/content.test.mjs scripts/navigation.test.mjs scripts/prepare-offline.test.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:desktop": "node scripts/check-ui.mjs --desktop",
    "prepare:offline": "node scripts/prepare-offline.mjs",
    "desktop": "electron .",
    "build:exe": "npm run prepare:offline && npm run build && electron-builder --config electron-builder.cjs --win portable --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.5"
  },
  "description": "Memoria institucional de ASONOG 2026, con mapas y fotografías disponibles sin conexión.",
  "author": "ASONOG",
  "main": "desktop/main.cjs",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
